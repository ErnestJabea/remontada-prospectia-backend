# ERP Remontada Prospectia — Production Backend Config (cPanel)
PORT=3002

# Base de données dédiée (cPanel MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=crm_user_prod
DB_PASSWORD=secure_password_here
DB_NAME=crm_database_prod

# Clés de chiffrement JWT (Remplacer par des chaînes aléatoires de 32+ caractères)
JWT_SECRET=jwt_secret_production_32_chars_long_minimum
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=jwt_refresh_secret_production_32_chars_long_minimum
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Autoriser les URLs de production (Backoffice et PWA mobile)
ALLOWED_ORIGINS=https://remontada-prospectia-backoffice.ippc-cm.com,https://remontada-api-test.ippc-cm.com
FRONTEND_ORIGINS=https://remontada-prospectia-backoffice.ippc-cm.com

# Cookies de session (HTTPS obligatoire en production)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Configuration SMTP pour Nodemailer (Envoi des emails d'OTP et mots de passe)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ernestjabea@gmail.com
SMTP_PASS=olecszojstcpmflx
SMTP_FROM="Remontada Prospectia" <ernestjabea@gmail.com>

# Désactiver les logs OTP en production
LOG_DEV_OTP=false
