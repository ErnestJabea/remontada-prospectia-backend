NODE_ENV=development
PORT=3002
# En developpement, limiter l'ecoute a la machine locale.
# En conteneur/reverse proxy, utiliser explicitement 0.0.0.0.
API_HOST=127.0.0.1
API_BODY_LIMIT=512kb

# Laisser a 0 si Node est expose directement. Mettre 1 uniquement derriere
# un reverse proxy unique et maitrise qui reecrit X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Origine publique HTTPS utilisee dans les QR codes des ordres de mission.
# Elle doit pointer vers cette API, sans le suffixe /api.
MISSION_VERIFICATION_PUBLIC_URL=https://remontada-api-test.ippc-cm.com

DB_HOST=localhost
DB_PORT=3306
DB_USER=crm_user
DB_PASSWORD=change-me
DB_NAME=nexus_crm

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_REFRESH_EXPIRES_IN=7d

ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,https://remontada-prospectia-backoffice.ippc-cm.com
# FRONTEND_ORIGINS est aussi accepte par compatibilite.
FRONTEND_ORIGINS=https://remontada-prospectia-backoffice.ippc-cm.com
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Provisoire uniquement: permet au backoffice de travailler sans JWT/cookie stable.
TEMP_SIMPLE_AUTH=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Remontada Prospectia <no-reply@example.com>"
SMTP_SECURE=false
SMTP_ALLOW_SELF_SIGNED=false

# Active uniquement si un OTP doit etre lu dans la console en developpement local.
LOG_DEV_OTP=false

# Ne jamais desactiver en production.
API_RATE_LIMIT_DISABLED=false

SEED_ADMIN_PASSWORD=
SEED_DIRECTION_PASSWORD=
SEED_COMMERCIAL_JR_PASSWORD=
SEED_COMMERCIAL_SR_PASSWORD=

# Web Push: generate once per environment; never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
