APP_NAME="Remontada Prospectia API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:3002
APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# Même base MySQL que le backend Node.js. Sur cPanel, le nom est préfixé (ex. cpuser_nexus_crm).
# Schéma de référence : database/schema/baseline-node.sql (jamais chargé automatiquement)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexus_crm
DB_USERNAME=crm_user
DB_PASSWORD=change-me
# Fuseau des DATETIME écrits par Node (pour la conversion ISO UTC des réponses)
DB_WALL_TIMEZONE=Africa/Douala

# API sans état. Un seul serveur cPanel : CACHE_STORE=file suffit (tickets MFA, rate limit).
# Plusieurs serveurs : CACHE_STORE=redis obligatoire.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Réutiliser les MÊMES secrets que Node pour garder les sessions ouvertes
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_REFRESH_EXPIRES_IN=7d

ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# Production : origines exactes des deux frontends (schéma + hôte, sans slash final)
FRONTEND_ORIGINS=https://bo-remontada.ippc-cm.com,https://pwa.ippc-cm.com
COOKIE_SECURE=false
# API et backoffice sous ippc-cm.com = même site : lax suffit (COOKIE_SECURE=true en production)
COOKIE_SAMESITE=lax
TRUST_PROXY_HOPS=0
API_BODY_LIMIT=512kb
API_RATE_LIMIT_DISABLED=false

MISSION_VERIFICATION_PUBLIC_URL=https://remontada-api-test.ippc-cm.com
# Lien des e-mails de création de mot de passe
BACKOFFICE_PUBLIC_URL=https://bo-remontada.ippc-cm.com
# Libellé de fuseau produit par Node dans String(Date) — conserve les empreintes déjà imprimées
NODE_TZ_LABEL="West Africa Standard Time"

# Racine des pièces jointes, HORS du dossier déployé (ex. /home/cpuser/remontada-data/uploads).
# Pendant la migration : pointer vers le dossier uploads/ de l'ancien backend Node.
UPLOAD_ROOT=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Remontada Prospectia"
LOG_DEV_OTP=false

# Notifications temps réel. cPanel : snapshot + minute. VPS : long + ten_seconds (schedule:work).
NOTIFICATIONS_STREAM_MODE=snapshot
NOTIFICATIONS_STREAM_RETRY_MS=20000
NOTIFICATION_DELIVERY_FREQUENCY=minute

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
