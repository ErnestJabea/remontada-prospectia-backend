# Filet de sécurité cPanel : si la racine du (sous-)domaine pointe par erreur
# sur ce dossier au lieu de public/, rien n'est servi (.env, storage, vendor…).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
